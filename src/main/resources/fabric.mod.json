{
	"schemaVersion": 1,
	"id": "notfullybroken_mt",
	"version": "${version}",
	"name": "NotFullyBroken",
	"description": "In Minecraft, you can easily break your best tools if something distracts you. NotFullyBroken fixes that. Now, all tools with mending and 0 durability will change to their broken state, in which you can't use them. To move them out of the broken state, you simply recover them using XP.",
	"authors": [
		"MARS Team MC",
		"MDen",
		"cocer"
	],
	"contact": {
		"homepage": "https://github.com/MARSTeamMC/NotFullyBroken",
		"sources": "https://github.com/MARSTeamMC/NotFullyBroken"
	},
	"license": "BSD 2-Clause License",
	"icon": "assets/notfullybroken_mt/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.mars.notfullybroken_mt.NotFullyBroken"
		],
		"fabric-datagen": [
			"net.mars.notfullybroken_mt.NotFullyBrokenDataGenerator"
		]
	},
	"mixins": [
		"notfullybroken_mt.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.13",
		"minecraft": ">=1.21.2 <=1.21.8",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}